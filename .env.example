# Public browser configuration. NEXT_PUBLIC_ aliases also supported by Vinext.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep the sourced public catalogue available while Supabase powers accounts.
# Set to supabase only after migrating and importing the catalogue.
NEXT_PUBLIC_CATALOGUE_SOURCE=bundled
# Optional HTTPS donation/sponsorship checkout URL.
NEXT_PUBLIC_SUPPORT_URL=
# Equivalent names accepted by Next and Vinext:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true
# Optional production tile style. Default uses MapLibre demonstration tiles locally.
NEXT_PUBLIC_MAP_STYLE_URL=
# Server-only values: use .dev.vars with the Cloudflare runtime, never VITE_/NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Trusted Node ingestion worker/scheduler only; never expose in the browser.
INGEST_ALLOWED_HOSTS=
SCORECARD_API_KEY=
