{
  "name": "collegestat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "ingest:run": "node --import tsx scripts/ingestion/run.ts",
    "ingest:ror": "node --import tsx scripts/ingestion/import-ror.ts",
    "ingest:review": "node --import tsx scripts/ingestion/stage-review.ts",
    "ingest:review:check": "python3 scripts/ingestion/review-official-facts.py",
    "ingest:local": "node --import tsx scripts/ingestion/local-catalogue.ts",
    "ingest:public:fetch": "python3 scripts/ingestion/fetch-public.py",
    "ingest:public:normalize": "python3 scripts/ingestion/normalize-public.py",
    "ingest:global": "python3 scripts/ingestion/build-global.py && python3 scripts/ingestion/curate-directory.py",
    "ingest:rankings:link": "python3 scripts/ingestion/link-rankings.py && python3 scripts/ingestion/reconcile-ranked-identities.py",
    "ingest:global:sync": "node --import tsx scripts/ingestion/sync-global.ts",
    "ingest:current:fetch": "python3 scripts/ingestion/fetch-current.py",
    "ingest:profiles": "python3 scripts/ingestion/enrich-profiles.py",
    "data:export": "node --import tsx scripts/ingestion/export-library.ts",
    "supabase:bundle": "node --import tsx scripts/database/bundle.ts",
    "ingest:web": "python3 scripts/ingestion/official-web-profiles.py",
    "ingest:papers": "python3 scripts/ingestion/expand-papers.py",
    "supabase:review-account": "node --import tsx scripts/database/create-review-account.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.11.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^7.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
