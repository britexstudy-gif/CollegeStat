{
  "type": "object",
  "additionalProperties": false,
  "required": ["universities"],
  "properties": {
    "universities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "english", "tuition", "application_fee", "deadlines", "sat", "acceptance_rate", "notes"],
        "properties": {
          "id": { "type": "string" },
          "english": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["test", "minimum", "detail", "source_url"],
              "properties": {
                "test": { "type": "string", "enum": ["IELTS", "TOEFL iBT", "Duolingo", "PTE Academic", "Cambridge C1/C2"] },
                "minimum": { "type": "number" },
                "detail": { "type": "string" },
                "source_url": { "type": "string" }
              }
            }
          },
          "tuition": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["amount", "amount_max", "currency", "period", "academic_year", "detail", "source_url"],
                "properties": {
                  "amount": { "type": "number" },
                  "amount_max": { "type": ["number", "null"] },
                  "currency": { "type": "string" },
                  "period": { "type": "string", "enum": ["year", "semester", "total"] },
                  "academic_year": { "type": "string" },
                  "detail": { "type": "string" },
                  "source_url": { "type": "string" }
                }
              }
            ]
          },
          "application_fee": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["amount", "currency", "source_url"],
                "properties": { "amount": { "type": "number" }, "currency": { "type": "string" }, "source_url": { "type": "string" } }
              }
            ]
          },
          "deadlines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "due_at", "route", "source_url"],
              "properties": {
                "title": { "type": "string" },
                "due_at": { "type": "string" },
                "route": { "type": "string" },
                "source_url": { "type": "string" }
              }
            }
          },
          "sat": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["policy", "p25", "p75", "source_url"],
                "properties": {
                  "policy": { "type": "string", "enum": ["required", "optional", "not_considered", "accepted_alternative"] },
                  "p25": { "type": ["number", "null"] },
                  "p75": { "type": ["number", "null"] },
                  "source_url": { "type": "string" }
                }
              }
            ]
          },
          "acceptance_rate": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["percent", "year", "source_url"],
                "properties": { "percent": { "type": "number" }, "year": { "type": "string" }, "source_url": { "type": "string" } }
              }
            ]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
